@startuml
title Hotelio Context Diagram

Top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

System_Ext(sysApp, "Client App")
System_Ext(sysPartners, "Partners Integrations")

'monolyth
System(sysHotelio, "Hotelio")
Container_Boundary(sysHotelio, ""){
    ContainerDb(cntDbBooking, "DB", "PostgreSQL", "Stores data"){
    }
    ContainerDb(cntDbUsers, "DB", "PostgreSQL", "Stores data\n")
    ContainerDb(cntDbHotels, "DB", "PostgreSQL", "Stores data\n")
    ContainerDb(cntDbPromocodes, "DB", "PostgreSQL", "Stores data\n"){
    }
    ContainerDb(cntDbReviews, "DB", "PostgreSQL", "Stores data\n")

    Container(cntBFF, "BFF")
    Container(cntAPIGateway, "API Gateway")

    Container(cntBooking, "Booking Service", "", "Manages bookings")
    Container(cntUsers, "User Service", "", "Manages user accounts")
    Container(cntHotels, "Hotel Service", "", "Manages hotel data")
    Container(cntPromocodes, "Promocode Service", "", "Manages promocodes")
    Container(cntReviews, "Review Service", "", "Manages reviews")

    Container(cntBroker, "Event Bus", "Kafka", "Handles messages delivering\n                                                                                                                                            ")
}

Lay_Right(cntDbBooking,cntDbUsers)
Lay_Right(cntDbUsers,cntDbHotels)
Lay_Right(cntDbHotels,cntDbPromocodes)
Lay_Right(cntDbPromocodes,cntDbReviews)

Lay_Right(cntBooking,cntUsers)
Lay_Right(cntUsers,cntHotels)
Lay_Right(cntHotels,cntPromocodes)
Lay_Right(cntPromocodes,cntReviews)

'external
Rel_Down(sysApp, cntAPIGateway, "GraphQL")
Rel_Down(sysPartners, cntAPIGateway, "REST API\ncalls")

'broker
Rel(cntBooking, cntBroker, "Interacts")
Rel(cntUsers, cntBroker, "Interacts")
Rel(cntHotels, cntBroker, "Interacts")
Rel(cntPromocodes, cntBroker, "Interacts")
Rel(cntReviews, cntBroker, "Interacts")

'bff
Rel(cntAPIGateway, cntBFF, "Redirects\nGraphQL")
Rel(cntAPIGateway, cntBooking, "Redirects\nREST API")
Rel(cntAPIGateway, cntUsers, "Redirects\nREST API")
Rel(cntAPIGateway, cntHotels, "Redirects\nREST API")
Rel(cntAPIGateway, cntPromocodes, "Redirects\nREST API")
Rel(cntAPIGateway, cntReviews, "Redirects\nREST API")

Rel(cntBFF, cntBooking, "REST API\ncalls")
Rel(cntBFF, cntUsers, "REST API\ncalls")
Rel(cntBFF, cntHotels, "REST API\ncalls")
Rel(cntBFF, cntPromocodes, "REST API\ncalls")
Rel(cntBFF, cntReviews, "REST API\ncalls")

'db
Rel_Up(cntBooking, cntDbBooking, "Reads/Writes\ndata")
Rel_Up(cntUsers, cntDbUsers, "Reads/Writes\ndata")
Rel_Up(cntHotels, cntDbHotels, "Reads/Writes\ndata")
Rel_Up(cntPromocodes, cntDbPromocodes, "Reads/Writes\ndata")
Rel_Up(cntReviews, cntDbReviews, "Reads/Writes\ndata")
@enduml